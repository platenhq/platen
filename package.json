{
  "name": "platen",
  "version": "0.1.3",
  "private": true,
  "description": "Enterprise-grade collaborative document editor",
  "author": "Platen Authors (Trayshmhirk)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platenhq/platen.git"
  },
  "homepage": "https://github.com/platenhq/platen#readme",
  "bugs": {
    "url": "https://github.com/platenhq/platen/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:fix": "npm audit fix",
    "security:outdated": "npm outdated",
    "reset": "npx -y rimraf .next node_modules package-lock.json && npm install",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.8",
    "@clerk/themes": "^2.4.57",
    "@fontsource-variable/inter": "^5.3.0",
    "@lexical/react": "^0.35.0",
    "@lexical/rich-text": "^0.35.0",
    "@lexical/utils": "^0.35.0",
    "@lexical/yjs": "^0.35.0",
    "@liveblocks/client": "^3.24.0",
    "@liveblocks/node": "^3.24.0",
    "@liveblocks/react": "^3.24.0",
    "@liveblocks/react-lexical": "^3.24.0",
    "@liveblocks/react-ui": "^3.24.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.70.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lexical": "^0.35.0",
    "lodash-es": "^4.17.21",
    "lucide": "^0.460.0",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.2",
    "next": "15.5.25",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-spinners": "^0.15.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "@lexical/react": "^0.35.0",
    "@lexical/utils": "^0.35.0",
    "@lexical/yjs": "^0.35.0",
    "lexical": "^0.35.0",
    "brace-expansion": "^1.1.18",
    "postcss": "^8.5.3",
    "sharp": "^0.35.4",
    "js-yaml": "^4.3.2"
  }
}
